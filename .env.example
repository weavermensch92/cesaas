# =========================================================================
# HD건설기계 PoC — 환경변수 예시
# 실제 시크릿은 GCP Secret Manager에 보관 (C_08_배포_환경변수.md 참조)
# =========================================================================

# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-opus-4-7
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-4-6

# ---- Sensor Extension HMAC ----
SENSOR_HMAC_KEY_ID=ext_001
SENSOR_HMAC_SECRET=

# ---- Voice JWT (Dealer) ----
VOICE_JWT_SECRET=
VOICE_JWT_ISSUER=hd-poc
VOICE_JWT_EVENT=ctt_moscow_2026

# ---- Admin allowed email domains (콤마 구분) ----
# "hyundai" 표기 금지 — HD 도메인 표기 사용
ADMIN_EMAIL_DOMAINS=hd.com,gridge.co.kr

# ---- CORS 화이트리스트 (콤마 구분) ----
CORS_ALLOWED_ORIGINS=chrome-extension://__SENSOR_EXTENSION_ID__,https://dealer.example,https://visitor.example,https://admin.example,http://localhost:3000

# ---- R_10 룰 로더 ----
R10_RULES_DIR=./C_Common/r_10_rules
R10_HOT_RELOAD=true

# ---- 로깅·메트릭 ----
LOG_LEVEL=info
METRICS_NAMESPACE=hd_poc
