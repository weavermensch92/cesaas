# Next.js admin — public 환경변수만 사용 (브라우저 노출 가능).
# service_role은 절대 X.

NEXT_PUBLIC_SUPABASE_URL=https://__SUPABASE_REF__.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=__SUPABASE_ANON_KEY__

# Edge Functions base — 기본은 SUPABASE_URL/functions/v1
NEXT_PUBLIC_API_BASE=https://__SUPABASE_REF__.supabase.co/functions/v1

# Admin 로그인 후 리다이렉트 URL (Magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
