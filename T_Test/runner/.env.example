# T_Test runner — .env.local 에 복사 후 실 값 채우기.

SUPABASE_URL=https://__SUPABASE_REF__.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__SERVICE_ROLE_KEY__

# Voice JWT (Dealer 토큰 발급) — VOICE_JWT_SECRET 미지정 시 T_05 Dealer 단계 skip
VOICE_JWT_SECRET=__JWT_SECRET__
VOICE_JWT_ISSUER=hd-poc

# 옵션 — API base 강제 지정 (기본: SUPABASE_URL/functions/v1)
T_TEST_API_BASE=

# 식별·라벨
T_TEST_EVENT=ctt_moscow_2026
T_TEST_ACTOR=weaver@gridge.co.kr
T_TEST_ENV=dev

# LLM 정규화 실측까지 돌릴지 (Anthropic 비용 발생)
T_TEST_LLM=false

# normalize-worker 폴링 timeout (ms)
T_TEST_NORMALIZE_TIMEOUT_MS=120000

# Visitor 24h quota 테스트 (5건 송출 후 6번째 429 검증)
T_TEST_QUOTA=false

# 실행 후 fixture rows 정리 여부
T_TEST_CLEANUP=true
